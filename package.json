{
  "name": "pi-codex-quota",
  "version": "0.1.0",
  "private": true,
  "description": "Codex quota, reset countdown, and usage pacing for Pi",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jgorset/pi-codex-quota.git" },
  "homepage": "https://github.com/jgorset/pi-codex-quota#readme",
  "bugs": { "url": "https://github.com/jgorset/pi-codex-quota/issues" },
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "codex", "quota"],
  "engines": { "node": ">=24" },
  "pi": { "extensions": ["./dist/index.ts"] },
  "files": ["dist/index.ts", "README.md", "CHANGELOG.md", "LICENSE"],
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:host": "node --test test/*.host.mjs",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run build:check && npm run test:host && npm run test:package"
  }
}
